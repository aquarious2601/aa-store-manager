# Copy to .env.local and fill in. Do NOT commit .env.local.
#
# On production servers, set APP_ENV=prod here. The default in .env is `dev`,
# which pulls dev-only bundles (MakerBundle, DoctrineFixturesBundle) — those
# are NOT installed when you run `composer install --no-dev`, so leaving
# APP_ENV=dev on a prod box gives:
#   Class "Symfony\Bundle\MakerBundle\MakerBundle" not found
# Setting it here overrides .env so the prod bundles list is loaded instead.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=generate-a-random-32char-string-here
JWT_PASSPHRASE=a-strong-passphrase-for-the-keypair
DATABASE_URL="mysql://YOUR_USER:YOUR_PASS@127.0.0.1:3306/aashop?serverVersion=8.0&charset=utf8mb4"
