# Copy this file to .env and fill in your real credentials.
# .env is git-ignored — never commit your real password.

# --- koreancosmetics.fr public order history (scrape_orders.py) ---
KOCO_EMAIL=aacosmetiqueparis@gmail.com
KOCO_PASSWORD=replace-me

# --- kcodeon.koreancosmetics.fr Dolibarr admin (scrape_product_details.py) ---
KCODEON_LOGIN=replace-me
KCODEON_PASSWORD=replace-me

# Set HEADLESS=0 to watch the browser run (useful when debugging selectors)
HEADLESS=1
OUTPUT=orders.json
PRODUCT_OUTPUT=product_details.json
SALES_OUTPUT=sales.json
# Hard cap on the number of sales to scrape after pagination + filtering.
SALES_MAX=2000
# How many pages to walk on /compta/facture/list.php (1000 sales per page).
# 2 = the most recent ~2000 sales.
SALES_PAGES=2
# Reference filter (regex). Default keeps only TC-prefixed invoices; set to
# "." to disable filtering, or e.g. "^(TC|TC2)" to keep multiple prefixes.
SALES_REF_PATTERN=^TC

# Incremental order scraping. When CREATE_ONLY=1, scrape_orders.py reads the
# existing OUTPUT file and skips any reference already in it whose status is
# unchanged; a known order whose status changed (e.g. accepted -> livré) is
# re-fetched and merged on top of the existing entry.
CREATE_ONLY=0
